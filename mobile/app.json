{
  "expo": {
    "name": "فوائد جيمينج",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kora_royal_logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.emelasr.mobileapp",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون للصوت",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لرفع الصور",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق مكتبة الصور لرفع صورة اللاعب"
      }
    },
    "android": {
      "package": "com.emelasr.mobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#050B20",
        "foregroundImage": "./assets/images/kora_royal_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d53afd30-de6f-418b-8f32-01d45222810f"
      }
    },
    "owner": "emelasr"
  }
}

